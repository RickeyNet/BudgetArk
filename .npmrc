# React Native / Expo packages declare strict peer ranges that the working,
# tested dependency tree intentionally doesn't satisfy to the letter (e.g.
# react-native 0.86 asks for react ^19.2.3 while the Expo SDK pins react 19.2.0).
# `npm install`/`npm ci` enforce peers strictly and would fail on this; the tree
# in package-lock.json was resolved with peers relaxed. Make that the default so
# local installs and CI (`npm ci`) behave identically.
legacy-peer-deps=true
