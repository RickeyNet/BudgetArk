{
  "expo": {
    "name": "BudgetArk",
    "slug": "BudgetArk",
    "version": "1.10.2",
    "scheme": "budgetark",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgetark.app",
      "appleTeamId": "U8CU9DF92C",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "BudgetArk uses your local network to sync data with your partner's device.",
        "NSBonjourServices": [
          "_budgetark._tcp."
        ]
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "com.budgetark.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF1DC"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "VIBRATE",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "WRITE_EXTERNAL_STORAGE",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": "1.10.0",
    "updates": {
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "url": "https://u.expo.dev/08046ba8-b8f4-46ef-b98b-c31fe698c65b"
    },
    "owner": "rickeynet",
    "extra": {
      "eas": {
        "projectId": "08046ba8-b8f4-46ef-b98b-c31fe698c65b"
      }
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withScreenGuard",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF1DC"
        }
      ],
      "expo-iap",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "BudgetArk uses your photo library so you can attach receipt photos to expenses. Photos stay encrypted on your device.",
          "cameraPermission": "BudgetArk uses the camera so you can photograph receipts for your expenses. Photos stay encrypted on your device."
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickEntry",
              "label": "Quick Entry",
              "description": "Log an expense in one tap - pick a category and BudgetArk opens straight to the amount.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ]
  }
}
